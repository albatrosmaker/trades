# =============================================================================
# AI Equity Research Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Equity Research Platform"
APP_VERSION="1.0.0"

# One of: development | staging | production
ENVIRONMENT=development

# Set to "true" to enable verbose output and /docs UI (disable in production)
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars

# JWT expiry durations
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/equity_research

# Connection pool settings
POOL_SIZE=20
MAX_OVERFLOW=40
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# ---------------------------------------------------------------------------
# Redis Cache / Celery Broker
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_DEFAULT_TTL=3600

# Celery — keep on separate Redis DBs to avoid key collisions
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# AI / LLM APIs
# ---------------------------------------------------------------------------
# Anthropic Claude (required for AI analysis)
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# OpenAI (optional, for embeddings or fallback)
OPENAI_API_KEY=sk-...your-key-here...

# ---------------------------------------------------------------------------
# Financial Data APIs
# ---------------------------------------------------------------------------
# Financial Modeling Prep — https://financialmodelingprep.com
FMP_API_KEY=your-fmp-api-key

# SEC EDGAR API key (optional — public API works without one, but key raises limits)
SEC_API_KEY=your-sec-api-key

# ---------------------------------------------------------------------------
# CORS — allowed frontend origins
# ---------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=/tmp/uploads
REPORTS_DIR=/tmp/reports
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ---------------------------------------------------------------------------
# Docker Compose overrides (used by docker-compose.yml)
# ---------------------------------------------------------------------------
# Postgres superuser password (used by docker-compose service)
POSTGRES_PASSWORD=devpassword
